{
  "name": "openclaw-plugin-viable-system-claw",
  "version": "0.1.0",
  "description": "A recursive organization and adaptive compute allocator for OpenClaw.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": "2026.10.10-beta.5"
  },
  "dependencies": {
    "typebox": "1.3.35"
  },
  "devDependencies": {
    "openclaw": "2026.10.10-beta.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "@types/node": "^22.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.10-beta.5"
    },
    "build": {
      "openclawVersion": "2026.10.10-beta.5"
    },
    "controlUi": "./src/control-ui.ts"
  }
}
