{
  "name": "viable-system-claw",
  "version": "0.1.0",
  "description": "A recursive organization and adaptive compute allocator for OpenClaw.",
  "repository": "https://github.com/GoatInAHat/viable-system-claw",
  "keywords": [
    "viable-system-claw"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "npm --prefix hosts/openclaw run build",
    "check": "tsc -p hosts/openclaw/tsconfig.check.json",
    "test": "vitest run --config hosts/openclaw/vitest.config.ts",
    "build:ui": "npm --prefix hosts/openclaw run plugin:build",
    "validate": "npm --prefix hosts/openclaw run plugin:validate"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typebox": "1.3.35"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "private": true
}
